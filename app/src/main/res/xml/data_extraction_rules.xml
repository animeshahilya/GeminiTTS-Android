<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Settings live in device-protected storage, which isn't backed up by default. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="device_sharedpref" path="tts_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="device_sharedpref" path="tts_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
